    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.7.0</Version>
    <AssemblyName>RikaUpdater</AssemblyName>
    <Product>Rika Translator 本地更新</Product>
